{
  "name": "artil-connect",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun apps/server/src/main.ts",
    "db:generate": "bun run --filter @artil-ai/connect db:generate",
    "db:check": "bun run --filter @artil-ai/connect db:check",
    "build": "bun run --filter @artil-ai/connect build",
    "lint": "oxlint -c .config/oxlintrc.json",
    "fmt": "oxfmt -c .config/oxfmtrc.json '!apps/server/migrations'",
    "knip": "knip -c .config/knip.json",
    "typecheck": "tsc -p .config && bun run --filter '*' typecheck",
    "check": "bun run lint && bun run fmt --check && bun run knip && bun run db:check && bun run typecheck && bun test",
    "format": "bun run lint --fix && bun run fmt",
    "api:check": "bun run --filter @artil-ai/connect api:check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@types/bun": "1.3.14",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
