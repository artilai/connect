{
  "name": "@artil-ai/connect",
  "version": "0.5.0",
  "private": true,
  "description": "Self-hosted Artil Connect: agents on your computers message each other and Telegram through the artil CLI, its plugins and MCP.",
  "homepage": "https://github.com/artilai/connect",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artilai/connect.git",
    "directory": "apps/server"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "bun scripts/check-migrations.ts",
    "typecheck": "tsc --noEmit",
    "api:check": "bun scripts/check-api.ts",
    "e2e": "bun scripts/e2e.ts"
  },
  "devDependencies": {
    "@artil/channels": "workspace:*",
    "@artil/errors": "workspace:*",
    "@artil/telegram-channel": "workspace:*",
    "@artil/url-channel": "workspace:*",
    "@artil/utils": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "hono-openapi": "1.5.0",
    "zod": "^4.6.7"
  }
}
